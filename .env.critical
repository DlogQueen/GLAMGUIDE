# ⭐ CRITICAL ENVIRONMENT VARIABLES - MUST ADD THESE FIRST
# Without these, the app won't work at all

# ============================================
# 1. SUPABASE - Auth & Database (REQUIRED)
# ============================================
# Get from: https://app.supabase.com/project/_/settings/api
# Look for: "Project URL" and "anon public" key

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# 2. ELEVENLABS - AI Voice Coaching (REQUIRED)
# ============================================
# Get from: https://elevenlabs.io/app/settings/api-keys
# Create account → API Keys → Create new key

NEXT_PUBLIC_ELEVENLABS_API_KEY=

# ============================================
# ⚡ ADD THESE 3 FIRST, RESTART SERVER, TEST SIGN IN
# ============================================
