# 🔑 GLAM GUIDE AI - Environment Variables
# Copy this to .env.local and fill in your values

# ============================================
# ⭐ CRITICAL - App Won't Work Without These
# ============================================

# Supabase (Get from: https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ElevenLabs Voice (Get from: https://elevenlabs.io/app/settings/api-keys)
NEXT_PUBLIC_ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here

# ============================================
# ⚡ IMPORTANT - Features Won't Work
# ============================================

# DeepAR AR Camera (Get from: https://developers.deepar.ai/)
NEXT_PUBLIC_DEEPAR_LICENSE_KEY=your_deepar_license_key

# Groq AI (Get from: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_key_here

# OpenRouter Backup AI (Get from: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# ============================================
# ✨ OPTIONAL - Enhanced Features
# ============================================

# YouTube API for thumbnails (Get from: Google Cloud Console)
YOUTUBE_API_KEY=AIzaSy_your_youtube_api_key

# Google Analytics (Get from: https://analytics.google.com)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry Error Tracking (Get from: https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============================================
# 📱 MOBILE BUILD - Android Only
# ============================================

# Android SDK (for MacPorts users)
ANDROID_SDK_ROOT=/opt/local/share/android-sdk
ANDROID_HOME=/opt/local/share/android-sdk

# Android Signing Keystore (create with: keytool -genkey -v -keystore glam-guide.keystore -alias glamguide -keyalg RSA -keysize 2048 -validity 10000)
ANDROID_KEYSTORE_PATH=/path/to/glam-guide.keystore
ANDROID_KEYSTORE_PASSWORD=your_keystore_password
ANDROID_KEY_ALIAS=glamguide
ANDROID_KEY_PASSWORD=your_key_password
