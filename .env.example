# ElevenLabs API Key for Premium AI Voice
# Get your API key at: https://elevenlabs.io/app/settings/api-keys
NEXT_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Supabase Configuration (already set up)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# DeepAR License Key
NEXT_PUBLIC_DEEPAR_LICENSE_KEY=your_deepar_key

# AI Services
GROQ_API_KEY=your_groq_key
OPENROUTER_API_KEY=your_openrouter_key

# YouTube API (Optional - for video thumbnails & search)
# Get API key at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Note: Videos play without API key. Only needed for thumbnails, view counts, and search features.
YOUTUBE_API_KEY=your_youtube_api_key_here_optional
